<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Financial data should not be backed up to cloud for security -->
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <!-- Allow device transfer but exclude sensitive financial data -->
        <exclude domain="database" />
        <exclude domain="sharedpref" path="flutter.sensitive_data" />
    </device-transfer>
</data-extraction-rules>